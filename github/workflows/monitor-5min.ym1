# monitor-5min.yml
name: BASA V10 Monitoreo 5 Min
on:
  schedule: [{cron: '*/5 * * * *'}]
  workflow_dispatch:
jobs:
  monitorear:
    runs-on: ubuntu-latest
    steps:
      - run: |
          python -c "import requests; r=requests.get('https://itunes.apple.com/do/rss/topSongs/limit=5/json', timeout=10); print('✅ Monitoreo OK')"
